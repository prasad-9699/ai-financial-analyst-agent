# ══════════════════════════════════════════════════════
# AI Financial Analyst Agent — Environment Variables
# ══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required: Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Required: Supabase project credentials (auth & chat persistence)
# Create a free project at https://supabase.com/dashboard
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# Optional: Override defaults
# MODEL_NAME=llama-3.3-70b-versatile
# MODEL_TEMPERATURE=0
# MAX_CSV_SIZE_MB=50
# MAX_PDF_SIZE_MB=20
# LOG_LEVEL=INFO

# Optional: Tesseract path (only needed if not on system PATH, e.g. Windows)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
